        u"H-Hehehe\u2026 You think I\u2019d let you do all the work, Yoshi~?": u"H-Hehehe\u2026 Voc\u00ea acha que eu deixaria voc\u00ea fazer todo o trabalho, Yoshi~?",
        u"H-Hehe\u2026 I hope you saved some room for dessert\u2026": u"H-Hehe\u2026 Espero que tenha deixado um espacinho para a sobremesa\u2026",
